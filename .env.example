# Set through your shell; Tiller does not automatically load this file.
# Or copy to .env and run: node --env-file=.env dist/src/cli.js <command>
TILLER_PROVIDER=ollama
TILLER_MODEL=lfm2.5:8b

# Optional OpenAI API credentials. Keep real keys only in your local .env.
# Select API execution with --provider openai --model YOUR_MODEL_ID.
OPENAI_API_KEY=
