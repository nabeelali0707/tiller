# Copy to .env and paste your OpenAI API key below.
# Tiller automatically reads .env from your current directory.
# Shell settings and command-line flags override these values.
OPENAI_API_KEY=
TILLER_PROVIDER=openai
TILLER_MODEL=gpt-4.1

# For local Ollama, replace the provider/model above with:
# TILLER_PROVIDER=ollama
# TILLER_MODEL=lfm2.5:8b
